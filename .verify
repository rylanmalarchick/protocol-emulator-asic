# RTL simulation with cocotb. /usr/bin goes first so the system iverilog/vvp
# load libpython; the OSS CAD Suite vvp bundles an older glibc and cannot.
set -e
cd test
make clean >/dev/null
PATH="$HOME/.venvs/stable/bin:/usr/bin:$PATH" make
cd ..
# Formal proofs with SymbiYosys (OSS CAD Suite on PATH).
make -C formal
# Lean ISA model. lake build passes with sorry, so fail on it here.
# Lean prints: declaration uses `sorry`  (the dots match either quote style).
lean_log=$(cd lean && lake build 2>&1) || { echo "$lean_log"; exit 1; }
echo "$lean_log" | tail -1
if echo "$lean_log" | grep -E 'declaration uses .sorry.'; then
    echo "lean: sorry found" >&2
    exit 1
fi
